<UserControl
    x:Class="Osmium.App.Controls.SettingsRowCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Osmium.App.Helpers">

    <Grid>
        <Border x:Name="StandaloneChromeBorder"
                Background="{ThemeResource OsmiumCardBrush}"
                BorderBrush="{ThemeResource OsmiumCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8" />

        <StackPanel x:Name="ContentStack" Margin="18,13" Spacing="10">
            <Grid ColumnSpacing="14" MinHeight="38">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon x:Name="RowGlyphIcon"
                          Grid.Column="0"
                          FontFamily="{StaticResource FluentIconsFont}"
                          FontSize="22"
                          Width="28"
                          Height="28"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="RowTitleText"
                               FontSize="14"
                               FontWeight="Medium"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               helpers:TrimmedToolTip.IsEnabled="True" />
                    <TextBlock x:Name="RowDescriptionText"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               Visibility="Collapsed" />
                </StackPanel>

                <ContentPresenter x:Name="RowActionPresenter"
                                  Grid.Column="2"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right" />
            </Grid>

            <ContentPresenter x:Name="RowFooterPresenter"
                              Margin="42,0,0,0"
                              Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>