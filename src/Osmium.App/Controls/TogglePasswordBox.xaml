<UserControl
    x:Class="Osmium.App.Controls.TogglePasswordBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   Grid.Row="0"
                   FontSize="14"
                   Margin="0,0,0,6"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                   Visibility="Collapsed" />

        <Grid Grid.Row="1">
            <PasswordBox x:Name="InnerPasswordBox"
                         FontFamily="{StaticResource AppGlobalFont}"
                         PasswordRevealMode="Hidden"
                         Padding="11,5,36,6"
                         CornerRadius="6"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         PasswordChanged="InnerPasswordBox_PasswordChanged" />

            <Button x:Name="RevealToggleBtn"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"
                    Width="28"
                    Height="28"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="4"
                    IsTabStop="False"
                    Click="RevealToggleBtn_Click">
                <FontIcon x:Name="RevealIcon"
                          FontFamily="{StaticResource FluentIconsFont}"
                          Glyph="&#xE5F6;"
                          FontSize="15"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Button>
        </Grid>
    </Grid>
</UserControl>