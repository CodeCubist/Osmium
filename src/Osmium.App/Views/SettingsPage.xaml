                                       Minimum="0" Maximum="65535" ValueChanged="NetworkNumberBox_ValueChanged" />
                        </controls:SettingsRowCard>

                        <controls:SettingsRowCard x:Name="RowPacketSize" Glyph="&#xF4C8;">
                            <NumberBox x:Name="PacketSizeBox" Style="{StaticResource OsmiumRowNumberBoxStyle}"
                                       Minimum="512" Maximum="1460" ValueChanged="NetworkNumberBox_ValueChanged" />
                        </controls:SettingsRowCard>

                        <controls:SettingsRowCard x:Name="RowEnableEncryption" Glyph="&#xEAD1;">
                            <ToggleSwitch x:Name="EnableEncryptionSwitch"
                                          Style="{StaticResource OsmiumCompactToggleStyle}"
                                          Toggled="EnableEncryptionSwitch_Toggled" />
                        </controls:SettingsRowCard>
                    </StackPanel>


