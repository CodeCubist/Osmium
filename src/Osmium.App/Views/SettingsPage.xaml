<Page
    x:Class="Osmium.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Osmium.App.Controls"
    NavigationCacheMode="Required">

    <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SettingsTitleText"
                   Grid.Row="0"
                   Style="{StaticResource OsmiumPageTitleStyle}"
                   Margin="0,0,0,8" />

        <NavigationView
            x:Name="SettingsNavView"
            Grid.Row="1"
            Margin="-12,0,0,10"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Top"
            SelectionChanged="SettingsNavView_SelectionChanged">
            <NavigationView.Resources>
                <x:Double x:Key="NavigationViewTopPaneHeight">42</x:Double>
                <x:Double x:Key="TopNavigationViewPaneCustomContentMinWidth">0</x:Double>
                <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
                <Thickness x:Key="TopNavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="TopNavigationViewContentMargin">0</Thickness>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TopNavigationViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TopNavigationViewItemBackgroundPressed" Color="Transparent" />
                <SolidColorBrush x:Key="TopNavigationViewItemBackgroundSelected" Color="Transparent" />
                <SolidColorBrush x:Key="TopNavigationViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TopNavigationViewItemBackgroundSelectedPressed" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="Transparent" />
                <Style TargetType="NavigationViewItem">
                    <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavTabGeneral" Tag="General" IsSelected="True" />
                <NavigationViewItem x:Name="NavTabCaptureSecurity" Tag="CaptureSecurity" />
                <NavigationViewItem x:Name="NavTabRemotePower" Tag="RemotePower" />
                <NavigationViewItem x:Name="NavTabVideo" Tag="Video" />
                <NavigationViewItem x:Name="NavTabAudioInput" Tag="AudioInput" />
                <NavigationViewItem x:Name="NavTabNetwork" Tag="Network" />
                <NavigationViewItem x:Name="NavTabDevices" Tag="Devices" />
                <NavigationViewItem x:Name="NavTabAbout" Tag="About" />
            </NavigationView.MenuItems>
        </NavigationView>

        <Grid x:Name="SettingsTabViewport" Grid.Row="2" SizeChanged="SettingsTabViewport_SizeChanged">
            <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0,0,4,12">
                <Grid>

                    <StackPanel x:Name="PanelGeneral" Spacing="8">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PanelGeneralTranslate" X="0" />
                        </StackPanel.RenderTransform>

                        <InfoBar x:Name="LangRestartBar" IsOpen="False" Severity="Success" IsClosable="True" />

                        <Border Style="{StaticResource OsmiumGroupedCardContainerStyle}">
                            <StackPanel>
                                <controls:SettingsRowCard x:Name="RowLanguage" IsGrouped="True" Glyph="&#xF834;">
                                    <ComboBox x:Name="LanguageCombo" Style="{StaticResource OsmiumRowComboBoxStyle}"
                                              SelectionChanged="LanguageCombo_SelectionChanged" />
                                </controls:SettingsRowCard>

                                <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                <controls:SettingsRowCard x:Name="RowTheme" IsGrouped="True" ShowIcon="False">
                                    <ComboBox x:Name="ThemeCombo" Style="{StaticResource OsmiumRowComboBoxStyle}"
                                              SelectionChanged="ThemeCombo_SelectionChanged" />
                                </controls:SettingsRowCard>
                            </StackPanel>
                        </Border>

                        <controls:SettingsRowCard x:Name="RowUiDisplayMode" Glyph="&#xEE5E;">
                            <ComboBox x:Name="UiDisplayModeCombo" Style="{StaticResource OsmiumRowComboBoxStyle}"
                                      SelectionChanged="ClientCombo_Changed" />
                        </controls:SettingsRowCard>

                        <Border Style="{StaticResource OsmiumGroupedCardContainerStyle}">
                            <StackPanel>
                                <controls:SettingsRowCard x:Name="RowKeepAwake" IsGrouped="True" Glyph="&#xF8A2;">
                                    <ToggleSwitch x:Name="KeepAwakeSwitch"
                                                  Style="{StaticResource OsmiumCompactToggleStyle}"
                                                  Toggled="SettingSwitch_Toggled" />
                                </controls:SettingsRowCard>

                                <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                <controls:SettingsRowCard x:Name="RowCloseToTray" IsGrouped="True" ShowIcon="False">
                                    <ToggleSwitch x:Name="CloseToTraySwitch"
                                                  Style="{StaticResource OsmiumCompactToggleStyle}"
                                                  Toggled="SettingSwitch_Toggled" />
                                </controls:SettingsRowCard>

                                <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                <controls:SettingsRowCard x:Name="RowHideToTrayOnMinimize" IsGrouped="True"
                                                          ShowIcon="False">
                                    <ToggleSwitch x:Name="HideToTrayOnMinimizeSwitch"
                                                  Style="{StaticResource OsmiumCompactToggleStyle}"
                                                  Toggled="SettingSwitch_Toggled" />
                                </controls:SettingsRowCard>

                                <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                <controls:SettingsRowCard x:Name="RowLaunchOnStartup" IsGrouped="True" ShowIcon="False">
                                    <ToggleSwitch x:Name="LaunchOnStartupSwitch"
                                                  Style="{StaticResource OsmiumCompactToggleStyle}"
                                                  Toggled="LaunchOnStartupSwitch_Toggled" />
                                </controls:SettingsRowCard>

                                <Border x:Name="ServiceAutoStartDivider"
                                        Style="{StaticResource OsmiumHorizontalDividerStyle}"
                                        Visibility="Collapsed" />

                                <controls:SettingsRowCard x:Name="RowServiceAutoStart"
                                                          IsGrouped="True"
                                                          ShowIcon="False"
                                                          Margin="20,0,0,0"
                                                          Visibility="Collapsed">
                                    <ToggleSwitch x:Name="ServiceAutoStartSwitch"
                                                  Style="{StaticResource OsmiumCompactToggleStyle}"
                                                  Toggled="ServiceAutoStartSwitch_Toggled" />
                                </controls:SettingsRowCard>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="SecClipboardTransferTitle"
                                   Style="{StaticResource OsmiumSectionHeaderStyle}"
                                   Margin="0,8,0,0" />

                        <Border Style="{StaticResource OsmiumGroupedCardContainerStyle}">
                            <StackPanel>
                                <controls:SettingsRowCard x:Name="RowSharedClipboardDefault" IsGrouped="True"
                                                          Glyph="&#xE49E;">
                                    <ToggleSwitch x:Name="SharedClipboardDefaultSwitch"
                                                  Style="{StaticResource OsmiumCompactToggleStyle}"
                                                  Toggled="SettingSwitch_Toggled" />
                                </controls:SettingsRowCard>

                                <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                <controls:SettingsRowCard x:Name="RowSharedClipboardImages" IsGrouped="True"
                                                          ShowIcon="False">
                                    <ToggleSwitch x:Name="SharedClipboardImagesSwitch"
                                                  Style="{StaticResource OsmiumCompactToggleStyle}"
                                                  Toggled="SettingSwitch_Toggled" />
                                </controls:SettingsRowCard>

                                <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                <controls:SettingsRowCard x:Name="RowSharedClipboardMaxSize" IsGrouped="True"
                                                          ShowIcon="False">
                                    <ComboBox x:Name="SharedClipboardMaxSizeCombo"
                                              Style="{StaticResource OsmiumRowComboBoxStyle}"
                                              SelectionChanged="ClientCombo_Changed">
                                        <ComboBoxItem Content="2 MB" Tag="2" />
                                        <ComboBoxItem Content="5 MB" Tag="5" />
                                        <ComboBoxItem Content="8 MB" Tag="8" />
                                        <ComboBoxItem Content="16 MB" Tag="16" />
                                        <ComboBoxItem Content="32 MB" Tag="32" />
                                    </ComboBox>
                                </controls:SettingsRowCard>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource OsmiumGroupedCardContainerStyle}">
                            <StackPanel>
                                <controls:SettingsRowCard x:Name="RowFileTransferDefault" IsGrouped="True"
                                                          Glyph="&#xF4C8;">
                                    <ToggleSwitch x:Name="FileTransferDefaultSwitch"
                                                  Style="{StaticResource OsmiumCompactToggleStyle}"
                                                  Toggled="SettingSwitch_Toggled" />
                                </controls:SettingsRowCard>

                                <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                <controls:SettingsRowCard x:Name="RowFileTransferDirection" IsGrouped="True"
                                                          ShowIcon="False">
                                    <ComboBox x:Name="FileTransferDirectionCombo"
                                              Style="{StaticResource OsmiumRowComboBoxStyle}"
                                              SelectionChanged="ClientCombo_Changed" />
                                </controls:SettingsRowCard>

                                <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                <controls:SettingsRowCard x:Name="RowFileTransferMaxSize" IsGrouped="True"
                                                          ShowIcon="False">
                                    <ComboBox x:Name="FileTransferMaxSizeCombo"
                                              Style="{StaticResource OsmiumRowComboBoxStyle}"
                                              SelectionChanged="ClientCombo_Changed">
                                        <ComboBoxItem Content="64 MB" Tag="64" />
                                        <ComboBoxItem Content="256 MB" Tag="256" />
                                        <ComboBoxItem Content="512 MB" Tag="512" />
                                        <ComboBoxItem Content="1 GB" Tag="1024" />
                                        <ComboBoxItem Content="2 GB" Tag="2048" />
                                    </ComboBox>
                                </controls:SettingsRowCard>

                                <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                <controls:SettingsRowCard x:Name="RowFileTransferClearCache" IsGrouped="True"
                                                          ShowIcon="False">
                                    <Button x:Name="ClearTransferCacheBtn"
                                            CornerRadius="6"
                                            Click="ClearTransferCacheBtn_Click" />
                                </controls:SettingsRowCard>
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <StackPanel x:Name="PanelCaptureSecurity" Spacing="12" Visibility="Collapsed">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PanelCaptureSecurityTranslate" X="0" />
                        </StackPanel.RenderTransform>


                        <TextBlock x:Name="SecHostVideoTitle" Style="{StaticResource OsmiumSectionHeaderStyle}" />
                        <StackPanel Spacing="6">
                            <controls:SettingsRowCard x:Name="RowHostDisplay" Glyph="&#xF35A;">
                                <ComboBox x:Name="HostDisplayCombo" Style="{StaticResource OsmiumRowComboBoxStyle}"
                                          MinWidth="240" MaxWidth="360" SelectionChanged="HostSettingChanged" />
                            </controls:SettingsRowCard>

                            <Border Style="{StaticResource OsmiumGroupedCardContainerStyle}">
                                <StackPanel>
                                    <controls:SettingsRowCard x:Name="RowHostMaxRes" IsGrouped="True" Glyph="&#xF66F;">
                                        <ComboBox x:Name="HostMaxResCombo"
                                                  Style="{StaticResource OsmiumRowComboBoxStyle}"
                                                  SelectionChanged="HostSettingChanged" />
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowHostLimitVideoRates" IsGrouped="True"
                                                              ShowIcon="False">
                                        <ToggleSwitch x:Name="HostLimitVideoRatesSwitch"
                                                      Style="{StaticResource OsmiumCompactToggleStyle}"
                                                      Toggled="HostLimitVideoRatesSwitch_Toggled" />
                                    </controls:SettingsRowCard>

                                    <StackPanel x:Name="HostVideoRateLimits" Visibility="Collapsed">
                                        <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                        <controls:SettingsRowCard x:Name="RowHostMaxFps" IsGrouped="True"
                                                                  ShowIcon="False">
                                            <ComboBox x:Name="HostMaxFpsCombo"
                                                      Style="{StaticResource OsmiumRowComboBoxStyle}"
                                                      SelectionChanged="HostSettingChanged">
                                                <ComboBoxItem Content="30 FPS" Tag="30" />
                                                <ComboBoxItem Content="60 FPS" Tag="60" />
                                                <ComboBoxItem Content="90 FPS" Tag="90" />
                                                <ComboBoxItem Content="120 FPS" Tag="120" />
                                                <ComboBoxItem Content="144 FPS" Tag="144" />
                                                <ComboBoxItem Content="165 FPS" Tag="165" />
                                                <ComboBoxItem Content="240 FPS" Tag="240" />
                                            </ComboBox>
                                        </controls:SettingsRowCard>

                                        <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                        <controls:SettingsRowCard x:Name="RowHostMaxBitrate" IsGrouped="True"
                                                                  ShowIcon="False">
                                            <controls:SettingsRowCard.ActionContent>
                                                <Border Background="{ThemeResource OsmiumSubtlePillBrush}"
                                                        CornerRadius="6"
                                                        Padding="10,4">
                                                    <TextBlock x:Name="HostBitrateLabel" Text="60 Mbps"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </controls:SettingsRowCard.ActionContent>
                                            <controls:SettingsRowCard.FooterContent>
                                                <Slider x:Name="HostBitrateSlider"
                                                        Minimum="2000"
                                                        Maximum="500000"
                                                        StepFrequency="1000"
                                                        ValueChanged="HostBitrateSlider_ValueChanged" />
                                            </controls:SettingsRowCard.FooterContent>
                                        </controls:SettingsRowCard>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource OsmiumGroupedCardContainerStyle}">
                                <StackPanel>
                                    <controls:SettingsRowCard x:Name="RowHostCodec" IsGrouped="True" Glyph="&#xF84D;">
                                        <ComboBox x:Name="HostCodecCombo"
                                                  Style="{StaticResource OsmiumRowComboBoxStyle}"
                                                  SelectionChanged="HostSettingChanged" />
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowHostEncoderMode" IsGrouped="True"
                                                              ShowIcon="False">
                                        <ComboBox x:Name="HostEncoderModeCombo"
                                                  Style="{StaticResource OsmiumRowComboBoxStyle}"
                                                  SelectionChanged="HostSettingChanged" />
                                    </controls:SettingsRowCard>
                                </StackPanel>
                            </Border>
                        </StackPanel>


                        <TextBlock x:Name="SecHostSecurityTitle" Style="{StaticResource OsmiumSectionHeaderStyle}" />
                        <StackPanel Spacing="6">
                            <controls:SettingsRowCard x:Name="RowDeviceAlias" Glyph="&#xE491;">
                                <TextBox x:Name="DeviceAliasBox"
                                         Style="{StaticResource OsmiumRowTextBoxStyle}"
                                         LostFocus="DeviceAliasBox_LostFocus" />
                            </controls:SettingsRowCard>

                            <Border Style="{StaticResource OsmiumGroupedCardContainerStyle}">
                                <StackPanel>
                                    <controls:SettingsRowCard x:Name="RowCodePolicy" IsGrouped="True" Glyph="&#xEAD1;">
                                        <ComboBox x:Name="CodePolicyCombo"
                                                  Style="{StaticResource OsmiumRowComboBoxStyle}"
                                                  SelectionChanged="HostSettingChanged" />
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowFixedSwitch" IsGrouped="True" ShowIcon="False">
                                        <ToggleSwitch x:Name="UseFixedCodeSwitch"
                                                      Style="{StaticResource OsmiumCompactToggleStyle}"
                                                      Toggled="FixedCodeSetting_Toggled" />
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowFixedBox" IsGrouped="True" ShowIcon="False">
                                        <controls:TogglePasswordBox x:Name="FixedCodeBox"
                                                                    Style="{StaticResource OsmiumRowPasswordBoxStyle}"
                                                                    LostFocus="FixedCodeBox_LostFocus" />
                                    </controls:SettingsRowCard>
                                </StackPanel>
                            </Border>
                        </StackPanel>


                        <TextBlock x:Name="SecHostPermissionsTitle" Style="{StaticResource OsmiumSectionHeaderStyle}" />
                        <StackPanel Spacing="6">
                            <controls:SettingsRowCard x:Name="RowHostAudio" Glyph="&#xEB43;">
                                <ToggleSwitch x:Name="HostCaptureAudioSwitch"
                                              Style="{StaticResource OsmiumCompactToggleStyle}"
                                              Toggled="HostPermissionSwitch_Toggled" />
                            </controls:SettingsRowCard>

                            <Border Style="{StaticResource OsmiumGroupedCardContainerStyle}">
                                <StackPanel>
                                    <controls:SettingsRowCard x:Name="RowHostInput" IsGrouped="True" Glyph="&#xE48D;">
                                        <ToggleSwitch x:Name="HostAllowInputSwitch"
                                                      Style="{StaticResource OsmiumCompactToggleStyle}"
                                                      Toggled="HostPermissionSwitch_Toggled" />
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowHostCursor" IsGrouped="True" ShowIcon="False">
                                        <ToggleSwitch x:Name="HostCaptureCursorSwitch"
                                                      Style="{StaticResource OsmiumCompactToggleStyle}"
                                                      Toggled="HostPermissionSwitch_Toggled" />
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowHostAllowPrivacyScreen" IsGrouped="True"
                                                              Glyph="&#xE48D;">
                                        <ToggleSwitch x:Name="HostAllowPrivacyScreenSwitch"
                                                      Style="{StaticResource OsmiumCompactToggleStyle}"
                                                      Toggled="HostPermissionSwitch_Toggled" />
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowHostPrivacyWallpaper" IsGrouped="True"
                                                              ShowIcon="False">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="HostPrivacyWallpaperBtn"
                                                    Click="HostPrivacyWallpaperBtn_Click" />
                                            <Button x:Name="HostResetPrivacyWallpaperBtn"
                                                    Click="HostResetPrivacyWallpaperBtn_Click" />
                                        </StackPanel>
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowHostSystemService" IsGrouped="True"
                                                              Glyph="&#xF6C5;">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="InstallSystemServiceBtn"
                                                    Click="InstallSystemServiceBtn_Click" />
                                            <Button x:Name="UninstallSystemServiceBtn"
                                                    Click="UninstallSystemServiceBtn_Click" />
                                        </StackPanel>
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowHostDrivers" IsGrouped="True" Glyph="&#xF588;">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="InstallDriversBtn"
                                                    Click="InstallDriversBtn_Click" />
                                            <Button x:Name="UninstallDriversBtn"
                                                    Click="UninstallDriversBtn_Click" />
                                        </StackPanel>
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowHostAllowRemoteDriverMgmt" IsGrouped="True"
                                                              Glyph="&#xEAD1;">
                                        <ToggleSwitch x:Name="HostAllowDriverMgmtSwitch"
                                                      Style="{StaticResource OsmiumCompactToggleStyle}"
                                                      Toggled="HostPermissionSwitch_Toggled" />
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowHostRequireDriverConfirm" IsGrouped="True"
                                                              ShowIcon="False">
                                        <ToggleSwitch x:Name="HostRequireDriverConfirmSwitch"
                                                      Style="{StaticResource OsmiumCompactToggleStyle}"
                                                      Toggled="HostPermissionSwitch_Toggled" />
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowHostAllowFileTransfer" IsGrouped="True"
                                                              Glyph="&#xF4C8;">
                                        <ToggleSwitch x:Name="HostAllowFileTransferSwitch"
                                                      Style="{StaticResource OsmiumCompactToggleStyle}"
                                                      Toggled="HostPermissionSwitch_Toggled" />
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowHostAllowQuickLaunch" IsGrouped="True"
                                                              Glyph="&#xEABB;">
                                        <ToggleSwitch x:Name="HostAllowQuickLaunchSwitch"
                                                      Style="{StaticResource OsmiumCompactToggleStyle}"
                                                      Toggled="HostPermissionSwitch_Toggled" />
                                    </controls:SettingsRowCard>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="SecHostAlertsTitle" Style="{StaticResource OsmiumSectionHeaderStyle}" />
                        <StackPanel Spacing="6">
                            <Border Style="{StaticResource OsmiumGroupedCardContainerStyle}">
                                <StackPanel>
                                    <controls:SettingsRowCard x:Name="RowHostNotifyOnConnect" IsGrouped="True"
                                                              Glyph="&#xF588;">
                                        <ToggleSwitch x:Name="HostNotifyOnConnectSwitch"
                                                      Style="{StaticResource OsmiumCompactToggleStyle}"
                                                      Toggled="HostPermissionSwitch_Toggled" />
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowHostFlashTaskbarOnConnect" IsGrouped="True"
                                                              ShowIcon="False">
                                        <ToggleSwitch x:Name="HostFlashTaskbarOnConnectSwitch"
                                                      Style="{StaticResource OsmiumCompactToggleStyle}"
                                                      Toggled="HostPermissionSwitch_Toggled" />
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowHostLockWindowDuringRemote" IsGrouped="True"
                                                              ShowIcon="False">
                                        <ToggleSwitch x:Name="HostLockWindowDuringRemoteSwitch"
                                                      Style="{StaticResource OsmiumCompactToggleStyle}"
                                                      Toggled="HostPermissionSwitch_Toggled" />
                                    </controls:SettingsRowCard>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>


                    <StackPanel x:Name="PanelRemotePower" Spacing="12" Visibility="Collapsed">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PanelRemotePowerTranslate" X="0" />
                        </StackPanel.RenderTransform>

                        <InfoBar x:Name="RemotePowerProfileWarningBar"
                                 Severity="Warning"
                                 IsOpen="False"
                                 IsClosable="False"
                                 Visibility="Collapsed" />

                        <TextBlock x:Name="SecRemotePowerLocalTitle" Style="{StaticResource OsmiumSectionHeaderStyle}" />
                        <Border Style="{StaticResource OsmiumGroupedCardContainerStyle}">
                            <StackPanel>
                                <controls:SettingsRowCard x:Name="RowHostAllowRemotePower" IsGrouped="True"
                                                          Glyph="&#xF60E;">
                                    <ToggleSwitch x:Name="HostAllowRemotePowerSwitch"
                                                  Style="{StaticResource OsmiumCompactToggleStyle}"
                                                  Toggled="HostAllowRemotePowerSwitch_Toggled" />
                                </controls:SettingsRowCard>

                                <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                <controls:SettingsRowCard x:Name="RowHostWolConfig" IsGrouped="True" ShowIcon="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:Name="ConfigureWolBtn"
                                                CornerRadius="6"
                                                Click="ConfigureWolBtn_Click" />
                                        <Button x:Name="RestoreWolBtn"
                                                CornerRadius="6"
                                                Click="RestoreWolBtn_Click" />
                                    </StackPanel>
                                </controls:SettingsRowCard>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="SecRemotePowerEnvTitle" Style="{StaticResource OsmiumSectionHeaderStyle}" />
                        <Border Style="{StaticResource OsmiumGroupedCardContainerStyle}">
                            <StackPanel>
                                <controls:SettingsRowCard x:Name="RowRemotePowerNicInfo" IsGrouped="True"
                                                          Glyph="&#xE99A;">
                                    <Border Background="{ThemeResource OsmiumSubtlePillBrush}"
                                            CornerRadius="6"
                                            Padding="10,4"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="RemotePowerMacText"
                                                   Text="-"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   IsTextSelectionEnabled="True" />
                                    </Border>
                                </controls:SettingsRowCard>

                                <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                <controls:SettingsRowCard x:Name="RowRemotePowerBiosTip" IsGrouped="True"
                                                          ShowIcon="False">
                                    <Button x:Name="BtnRefreshRemotePowerStatus"
                                            CornerRadius="6"
                                            Click="BtnRefreshRemotePowerStatus_Click" />
                                </controls:SettingsRowCard>
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <StackPanel x:Name="PanelVideo" Spacing="8" Visibility="Collapsed">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PanelVideoTranslate" X="0" />
                        </StackPanel.RenderTransform>

                        <controls:SettingsRowCard x:Name="RowClientRes" Glyph="&#xF66F;">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="ClientResCombo" MinWidth="185" CornerRadius="6"
                                          SelectionChanged="ClientResCombo_SelectionChanged" />
                                <Button x:Name="BtnCustomRes" CornerRadius="6" Click="CustomRes_Click" />
                            </StackPanel>
                        </controls:SettingsRowCard>

                        <controls:SettingsRowCard x:Name="RowClientFps" Glyph="&#xF831;">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="ClientFpsCombo" MinWidth="185" CornerRadius="6"
                                          SelectionChanged="ClientFpsCombo_SelectionChanged" />
                                <Button x:Name="BtnCustomFps" CornerRadius="6" Click="CustomFps_Click" />
                            </StackPanel>
                        </controls:SettingsRowCard>

                        <Border Style="{StaticResource OsmiumGroupedCardContainerStyle}">
                            <StackPanel>
                                <controls:SettingsRowCard x:Name="RowClientBitrate" IsGrouped="True" Glyph="&#xE619;">
                                    <controls:SettingsRowCard.ActionContent>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="ResetBitrateButton" CornerRadius="6" Padding="10,4"
                                                    Click="ResetBitrate_Click" />
