                        <controls:SettingsRowCard x:Name="RowShowSidebarDevices" Glyph="&#xEE5E;">
                            <ToggleSwitch x:Name="ShowSidebarDevicesSwitch"
                                          Style="{StaticResource OsmiumCompactToggleStyle}"
                                          Toggled="ShowSidebarDevicesSwitch_Toggled" />
