<Page
    x:Class="Osmium.App.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Osmium.App.Controls"
    NavigationCacheMode="Required">

    <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="AccountTitleText"
                   Grid.Row="0"
                   Style="{StaticResource OsmiumPageTitleStyle}"
                   Margin="0,0,0,8" />

        <ScrollViewer x:Name="UnauthScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,0,4,12">
            <Grid x:Name="UnauthSlideHost" SizeChanged="SlideHost_SizeChanged">
                <Border x:Name="ModeSelectCard"
                        Style="{StaticResource OsmiumGroupedCardContainerStyle}"
                        VerticalAlignment="Top">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ModeSelectCardTransform" />
                    </Border.RenderTransform>
                    <StackPanel x:Name="StepPanelModeSelect">
                        <InfoBar x:Name="AuthApiUnavailableBar"
                                 Severity="Error"
                                 IsOpen="False"
                                 IsClosable="False"
                                 Visibility="Collapsed"
                                 Margin="16,14,16,4">
                            <InfoBar.ActionButton>
                                <Button x:Name="BtnRetryAuthApi"
                                        CornerRadius="6"
                                        Click="BtnRetryAuthApi_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <Button x:Name="BtnChooseLogin"
                                Tag="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="18,14"
                                Click="ModeChoiceButton_Click">
                            <Grid ColumnSpacing="14" MinHeight="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          FontFamily="{StaticResource FluentIconsFont}"
                                          Glyph="&#xEAC8;"
                                          FontSize="22"
                                          Width="28"
                                          Height="28"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ModeLoginTitleText"
                                               FontSize="14"
                                               FontWeight="Medium" />
                                    <TextBlock x:Name="ModeLoginDescText"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <FontIcon Grid.Column="2"
                                          FontFamily="{StaticResource FluentIconsFont}"
                                          Glyph="&#xF2AF;"
                                          FontSize="13"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>

                        <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                        <Button x:Name="BtnChooseQrLogin"
                                Tag="3"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="18,14"
                                Click="ModeChoiceButton_Click">
                            <Grid ColumnSpacing="14" MinHeight="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0"
                                      Width="28"
                                      Height="28"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center">
                                    <Viewbox Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path Width="24" Height="24"
                                              Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                              Data="M3,3 H11 V11 H3 Z M5,5 V9 H9 V5 Z M6.5,6.5 H7.5 V7.5 H6.5 Z M13,3 H21 V11 H13 Z M15,5 V9 H19 V5 Z M16.5,6.5 H17.5 V7.5 H16.5 Z M3,13 H11 V21 H3 Z M5,15 V19 H9 V15 Z M6.5,16.5 H7.5 V17.5 H6.5 Z M13,13 H15 V15 H13 Z M17,13 H19 V15 H17 Z M15,15 H17 V17 H15 Z M19,15 H21 V17 H19 Z M13,17 H15 V19 H13 Z M17,17 H21 V21 H17 Z M15,19 H17 V21 H15 Z" />
                                    </Viewbox>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ModeQrLoginTitleText"
                                               FontSize="14"
                                               FontWeight="Medium" />
                                    <TextBlock x:Name="ModeQrLoginDescText"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <FontIcon Grid.Column="2"
                                          FontFamily="{StaticResource FluentIconsFont}"
                                          Glyph="&#xF2AF;"
                                          FontSize="13"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>

                        <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                        <Button x:Name="BtnChooseRegister"
                                Tag="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="18,14"
                                Click="ModeChoiceButton_Click">
                            <Grid ColumnSpacing="14" MinHeight="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          FontFamily="{StaticResource FluentIconsFont}"
                                          Glyph="&#xF10A;"
                                          FontSize="22"
                                          Width="28"
                                          Height="28"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ModeRegisterTitleText"
                                               FontSize="14"
                                               FontWeight="Medium" />
                                    <TextBlock x:Name="ModeRegisterDescText"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <FontIcon Grid.Column="2"
                                          FontFamily="{StaticResource FluentIconsFont}"
                                          Glyph="&#xF2AF;"
                                          FontSize="13"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>

                        <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                        <Button x:Name="BtnChooseReset"
                                Tag="2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="18,14"
                                Click="ModeChoiceButton_Click">
                            <Grid ColumnSpacing="14" MinHeight="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          FontFamily="{StaticResource FluentIconsFont}"
                                          Glyph="&#xEAD1;"
                                          FontSize="22"
                                          Width="28"
                                          Height="28"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ModeResetTitleText"
                                               FontSize="14"
                                               FontWeight="Medium" />
                                    <TextBlock x:Name="ModeResetDescText"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <FontIcon Grid.Column="2"
                                          FontFamily="{StaticResource FluentIconsFont}"
                                          Glyph="&#xF2AF;"
                                          FontSize="13"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>

                        <Border x:Name="OAuthSectionDivider"
                                Style="{StaticResource OsmiumHorizontalDividerStyle}"
                                Visibility="Collapsed" />

                        <StackPanel x:Name="OAuthSectionPanel"
                                    Padding="18,14,18,16"
                                    Spacing="12"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="OAuthSectionTitleText"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid x:Name="OAuthButtonsGrid" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnOAuthGoogle"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        Height="40"
                                        CornerRadius="6"
                                        Click="BtnOAuthGoogle_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#4285F4" Data="M23.745,12.27 C23.745,11.48 23.675,10.73 23.555,10 H12.255 V14.51 H18.725 C18.435,15.99 17.585,17.24 16.325,18.09 V21.09 H20.185 C22.445,19 23.745,15.92 23.745,12.27 Z" />
                                                <Path Fill="#34A853" Data="M12.255,24 C15.495,24 18.205,22.92 20.185,21.09 L16.325,18.09 C15.245,18.81 13.875,19.25 12.255,19.25 C9.125,19.25 6.475,17.14 5.525,14.29 H1.545 V17.38 C3.515,21.3 7.565,24 12.255,24 Z" />
                                                <Path Fill="#FBBC05" Data="M5.525,14.29 C5.275,13.57 5.145,12.8 5.145,12 C5.145,11.2 5.285,10.43 5.525,9.71 V6.62 H1.545 A11.86,11.86 0 0 0 1.545,17.38 L5.525,14.29 Z" />
                                                <Path Fill="#EA4335" Data="M12.255,4.75 C14.025,4.75 15.605,5.36 16.855,6.55 L20.275,3.13 C18.205,1.19 15.495,0 12.255,0 C7.565,0 3.515,2.7 1.545,6.62 L5.525,9.71 C6.475,6.86 9.125,4.75 12.255,4.75 Z" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="OAuthGoogleBtnText" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnOAuthQq"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Height="40"
                                        CornerRadius="6"
                                        Click="BtnOAuthQq_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#12B7F5" Data="M21.395,15.035 A39.548,39.548 0 0 0 20.592,12.771 L19.513,10.076 C19.514,10.044 19.527,9.514 19.527,9.24 C19.526,4.632 17.351,0 12,0 C6.649,0 4.474,4.632 4.474,9.241 C4.474,9.515 4.487,10.045 4.488,10.077 L3.408,12.772 A38.97,38.97 0 0 0 2.606,15.036 C1.585,18.319 1.916,19.679 2.168,19.709 C2.708,19.774 4.271,17.237 4.271,17.237 C4.271,18.706 5.027,20.624 6.665,22.008 C6.053,22.196 5.302,22.487 4.82,22.843 C4.386,23.163 4.441,23.489 4.519,23.621 C4.862,24.199 10.402,23.99 12.001,23.81 C13.601,23.99 19.141,24.199 19.484,23.621 C19.562,23.489 19.616,23.163 19.183,22.843 C18.7,22.487 17.95,22.197 17.337,22.007 C18.974,20.623 19.73,18.705 19.73,17.236 C19.73,17.236 21.293,19.773 21.833,19.708 C22.084,19.678 22.414,18.318 21.393,15.036 Z" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="OAuthQqBtnText" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnOAuthWechat"
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        Height="40"
                                        CornerRadius="6"
                                        Click="BtnOAuthWechat_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#07C160" Data="M8.691,2.188 C3.891,2.188 0,5.476 0,9.53 C0,11.742 1.17,13.733 3.002,15.08 A0.59,0.59 0 0 1 3.215,15.745 L2.825,17.225 C2.806,17.295 2.777,17.366 2.777,17.438 C2.777,17.601 2.907,17.733 3.067,17.733 A0.326,0.326 0 0 0 3.234,17.679 L5.137,16.565 A0.864,0.864 0 0 1 5.854,16.467 A10.16,10.16 0 0 0 8.691,16.87 C8.967,16.87 9.234,16.843 9.502,16.82 C8.645,14.242 9.659,11.848 11.434,10.374 C13.137,8.959 15.316,8.394 17.287,8.536 C16.711,4.953 13.091,2.188 8.691,2.188 Z M5.785,5.991 C6.427,5.991 6.947,6.52 6.947,7.171 A1.17,1.17 0 0 1 5.785,8.349 A1.17,1.17 0 0 1 4.623,7.17 C4.623,6.519 5.143,5.991 5.785,5.991 Z M11.598,5.991 C12.24,5.991 12.76,6.52 12.76,7.171 A1.17,1.17 0 0 1 11.598,8.349 A1.17,1.17 0 0 1 10.436,7.171 C10.436,6.52 10.956,5.991 11.598,5.991 Z M16.938,8.858 C15.141,8.806 13.192,9.37 11.658,10.644 C9.938,12.072 8.971,14.364 9.878,16.864 C10.82,19.317 13.544,21.093 16.762,21.093 C17.588,21.093 18.384,20.973 19.123,20.757 A0.722,0.722 0 0 1 19.721,20.839 L21.305,21.765 A0.272,0.272 0 0 0 21.445,21.812 C21.579,21.812 21.685,21.701 21.685,21.565 C21.685,21.505 21.662,21.445 21.647,21.388 L21.32,20.155 A0.582,0.582 0 0 1 21.297,19.999 A0.49,0.49 0 0 1 21.498,19.601 C23.024,18.48 24,16.82 24,14.98 C24,11.77 21.069,9.143 17.344,8.892 V8.89 C17.209,8.88 17.074,8.863 16.937,8.858 Z M14.408,12.132 C14.943,12.132 15.377,12.572 15.377,13.114 A0.976,0.976 0 0 1 14.408,14.097 A0.976,0.976 0 0 1 13.439,13.114 C13.439,12.572 13.873,12.132 14.409,12.132 Z M19.252,12.132 C19.787,12.132 20.221,12.572 20.221,13.114 A0.976,0.976 0 0 1 19.252,14.097 A0.976,0.976 0 0 1 18.283,13.114 C18.283,12.572 18.717,12.132 19.252,12.132 Z" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="OAuthWechatBtnText" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="WizardFlowPanel"
                            Spacing="10"
                            Visibility="Collapsed"
                            VerticalAlignment="Top">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="WizardFlowTransform" />
                    </StackPanel.RenderTransform>

                    <Border x:Name="WizardStepperCard"
                            Style="{StaticResource OsmiumGroupedCardContainerStyle}"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border x:Name="StepBadge1"
                                            Width="22"
                                            Height="22"
                                            CornerRadius="11"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <Grid>
                                            <TextBlock x:Name="StepNum1"
                                                       Text="1"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            <FontIcon x:Name="StepCheck1"
                                                      FontFamily="{StaticResource FluentIconsFont}"
                                                      Glyph="&#xE305;"
                                                      FontSize="11"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                      Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="StepLabel1"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Border x:Name="StepConnector1"
                                        Width="28"
                                        Height="2"
                                        CornerRadius="1"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource OsmiumDividerBrush}" />

                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border x:Name="StepBadge2"
                                            Width="22"
                                            Height="22"
                                            CornerRadius="11"
                                            Background="{ThemeResource OsmiumSubtlePillBrush}">
                                        <Grid>
                                            <TextBlock x:Name="StepNum2"
                                                       Text="2"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <FontIcon x:Name="StepCheck2"
                                                      FontFamily="{StaticResource FluentIconsFont}"
                                                      Glyph="&#xE305;"
                                                      FontSize="11"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                      Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="StepLabel2"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Border x:Name="StepConnector2"
                                        Width="28"
                                        Height="2"
                                        CornerRadius="1"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource OsmiumDividerBrush}"
                                        Visibility="Collapsed" />


                                <StackPanel x:Name="StepNode3"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <Border x:Name="StepBadge3"
                                            Width="22"
                                            Height="22"
                                            CornerRadius="11"
                                            Background="{ThemeResource OsmiumSubtlePillBrush}">
                                        <Grid>
                                            <TextBlock x:Name="StepNum3"
                                                       Text="3"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <FontIcon x:Name="StepCheck3"
                                                      FontFamily="{StaticResource FluentIconsFont}"
                                                      Glyph="&#xE305;"
                                                      FontSize="11"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                      Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="StepLabel3"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="StepProgressText"
                                       Grid.Column="1"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>


                    <Border Style="{StaticResource OsmiumGroupedCardContainerStyle}">
                        <StackPanel>
                            <Grid x:Name="WizardSlideHost" SizeChanged="SlideHost_SizeChanged">

                                <StackPanel x:Name="StepPanelIdentity" Visibility="Collapsed">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="StepIdentityTransform" />
                                    </StackPanel.RenderTransform>

                                    <controls:SettingsRowCard x:Name="RowAuthEmail" IsGrouped="True" Glyph="&#xF506;">
                                        <TextBox x:Name="AuthEmailBox"
                                                 Width="260"
                                                 CornerRadius="6"
                                                 InputScope="EmailSmtpAddress"
                                                 TextChanged="AuthEmailBox_TextChanged"
                                                 KeyDown="AuthInput_KeyDown" />
                                    </controls:SettingsRowCard>

                                    <Border x:Name="DividerAuthUsername"
                                            Style="{StaticResource OsmiumHorizontalDividerStyle}"
                                            Visibility="Collapsed" />

                                    <controls:SettingsRowCard x:Name="RowAuthUsername" IsGrouped="True"
                                                              ShowIcon="False" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox x:Name="AuthUsernameBox"
                                                     Width="182"
                                                     MaxLength="32"
                                                     CornerRadius="6"
                                                     KeyDown="AuthInput_KeyDown" />
                                            <Button x:Name="BtnRandomAuthUsername"
                                                    CornerRadius="6"
                                                    Click="BtnRandomAuthUsername_Click" />
                                        </StackPanel>
                                    </controls:SettingsRowCard>
                                </StackPanel>


                                <StackPanel x:Name="StepPanelOtp" Visibility="Collapsed">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="StepOtpTransform" />
                                    </StackPanel.RenderTransform>

                                    <controls:SettingsRowCard x:Name="RowOtpEmailSummary" IsGrouped="True"
                                                              Glyph="&#xF506;">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock x:Name="OtpEmailSummaryText"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       IsTextSelectionEnabled="True" />
                                            <Button x:Name="BtnSendAuthOtp"
                                                    MinWidth="96"
                                                    CornerRadius="6"
                                                    Click="BtnSendAuthOtp_Click" />
                                        </StackPanel>
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowAuthOtp" IsGrouped="True" ShowIcon="False">
                                        <TextBox x:Name="AuthOtpBox"
                                                 Width="260"
                                                 MaxLength="12"
                                                 CornerRadius="6"
                                                 KeyDown="AuthInput_KeyDown" />
                                    </controls:SettingsRowCard>
                                </StackPanel>


                                <StackPanel x:Name="StepPanelPassword" Visibility="Collapsed">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="StepPasswordTransform" />
                                    </StackPanel.RenderTransform>

                                    <controls:SettingsRowCard x:Name="RowPwdEmailSummary" IsGrouped="True"
                                                              Glyph="&#xEAC8;">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock x:Name="PwdEmailSummaryText"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       IsTextSelectionEnabled="True" />
                                            <Button x:Name="BtnChangeWizardEmail"
                                                    CornerRadius="6"
                                                    Click="BtnChangeWizardEmail_Click" />
                                        </StackPanel>
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowAuthPassword" IsGrouped="True"
                                                              ShowIcon="False">
                                        <controls:TogglePasswordBox x:Name="AuthPasswordBox"
                                                                    Width="260"
                                                                    CornerRadius="6"
                                                                    KeyDown="AuthInput_KeyDown" />
                                    </controls:SettingsRowCard>

                                    <Border x:Name="DividerAuthConfirmPwd"
                                            Style="{StaticResource OsmiumHorizontalDividerStyle}"
                                            Visibility="Collapsed" />

                                    <controls:SettingsRowCard x:Name="RowAuthConfirmPassword" IsGrouped="True"
                                                              ShowIcon="False" Visibility="Collapsed">
                                        <controls:TogglePasswordBox x:Name="AuthConfirmPasswordBox"
                                                                    Width="260"
                                                                    CornerRadius="6"
                                                                    KeyDown="AuthInput_KeyDown" />
                                    </controls:SettingsRowCard>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="WizardFooterDivider"
