                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PanelHistoryTransform" />
                        </StackPanel.RenderTransform>
                        <controls:SettingsRowCard x:Name="RowHistoryHeader" Glyph="&#xF2DD;">
                            <Button x:Name="BtnRefreshHistory" CornerRadius="6" Click="BtnRefreshHistory_Click" />
                        </controls:SettingsRowCard>

                        <StackPanel x:Name="HistoryListPanel" Spacing="8" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>


        <InfoBar x:Name="StatusInfoBar"
                 Grid.Row="2"
                 IsOpen="False"
                 IsClosable="True"
                 Margin="0,10,0,0" />
    </Grid>
</Page>