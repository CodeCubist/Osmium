<Page
    x:Class="Osmium.App.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Osmium.App.Controls"
    NavigationCacheMode="Required">

    <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="AccountTitleText"
                   Grid.Row="0"
                   Style="{StaticResource OsmiumPageTitleStyle}"
                   Margin="0,0,0,8" />

        <ScrollViewer x:Name="UnauthScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,0,4,12">
            <Grid x:Name="UnauthSlideHost" SizeChanged="SlideHost_SizeChanged">
                <Border x:Name="ModeSelectCard"
                        Style="{StaticResource OsmiumGroupedCardContainerStyle}"
                        VerticalAlignment="Top">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ModeSelectCardTransform" />
                    </Border.RenderTransform>
                    <StackPanel x:Name="StepPanelModeSelect">
                        <Button x:Name="BtnChooseLogin"
                                Tag="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="18,14"
                                Click="ModeChoiceButton_Click">
                            <Grid ColumnSpacing="14" MinHeight="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          FontFamily="{StaticResource FluentIconsFont}"
                                          Glyph="&#xEAC8;"
                                          FontSize="22"
                                          Width="28"
                                          Height="28"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ModeLoginTitleText"
                                               FontSize="14"
                                               FontWeight="Medium" />
                                    <TextBlock x:Name="ModeLoginDescText"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <FontIcon Grid.Column="2"
                                          FontFamily="{StaticResource FluentIconsFont}"
                                          Glyph="&#xF2AF;"
                                          FontSize="13"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>

                        <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                        <Button x:Name="BtnChooseQrLogin"
                                Tag="3"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="18,14"
                                Click="ModeChoiceButton_Click">
                            <Grid ColumnSpacing="14" MinHeight="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path Width="24" Height="24"
                                          Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                          Data="M3,3 H11 V11 H3 Z M5,5 V9 H9 V5 Z M6.5,6.5 H7.5 V7.5 H6.5 Z M13,3 H21 V11 H13 Z M15,5 V9 H19 V5 Z M16.5,6.5 H17.5 V7.5 H16.5 Z M3,13 H11 V21 H3 Z M5,15 V19 H9 V15 Z M6.5,16.5 H7.5 V17.5 H6.5 Z M13,13 H15 V15 H13 Z M17,13 H19 V15 H17 Z M15,15 H17 V17 H15 Z M19,15 H21 V17 H19 Z M13,17 H15 V19 H13 Z M17,17 H21 V21 H17 Z M15,19 H17 V21 H15 Z" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ModeQrLoginTitleText"
                                               FontSize="14"
                                               FontWeight="Medium" />
                                    <TextBlock x:Name="ModeQrLoginDescText"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <FontIcon Grid.Column="2"
                                          FontFamily="{StaticResource FluentIconsFont}"
                                          Glyph="&#xF2AF;"
                                          FontSize="13"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>

                        <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                        <Button x:Name="BtnChooseRegister"
                                Tag="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="18,14"
                                Click="ModeChoiceButton_Click">
                            <Grid ColumnSpacing="14" MinHeight="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          FontFamily="{StaticResource FluentIconsFont}"
                                          Glyph="&#xF10A;"
                                          FontSize="22"
                                          Width="28"
                                          Height="28"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ModeRegisterTitleText"
                                               FontSize="14"
                                               FontWeight="Medium" />
                                    <TextBlock x:Name="ModeRegisterDescText"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <FontIcon Grid.Column="2"
                                          FontFamily="{StaticResource FluentIconsFont}"
                                          Glyph="&#xF2AF;"
                                          FontSize="13"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>

                        <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                        <Button x:Name="BtnChooseReset"
                                Tag="2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="18,14"
                                Click="ModeChoiceButton_Click">
                            <Grid ColumnSpacing="14" MinHeight="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          FontFamily="{StaticResource FluentIconsFont}"
                                          Glyph="&#xEAD1;"
                                          FontSize="22"
                                          Width="28"
                                          Height="28"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ModeResetTitleText"
                                               FontSize="14"
                                               FontWeight="Medium" />
                                    <TextBlock x:Name="ModeResetDescText"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <FontIcon Grid.Column="2"
                                          FontFamily="{StaticResource FluentIconsFont}"
                                          Glyph="&#xF2AF;"
                                          FontSize="13"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="WizardFlowPanel"
                            Spacing="10"
                            Visibility="Collapsed"
                            VerticalAlignment="Top">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="WizardFlowTransform" />
                    </StackPanel.RenderTransform>

                    <Border x:Name="WizardStepperCard"
                            Style="{StaticResource OsmiumGroupedCardContainerStyle}"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border x:Name="StepBadge1"
                                            Width="22"
                                            Height="22"
                                            CornerRadius="11"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <Grid>
                                            <TextBlock x:Name="StepNum1"
                                                       Text="1"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            <FontIcon x:Name="StepCheck1"
                                                      FontFamily="{StaticResource FluentIconsFont}"
                                                      Glyph="&#xE305;"
                                                      FontSize="11"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                      Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="StepLabel1"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Border x:Name="StepConnector1"
                                        Width="28"
                                        Height="2"
                                        CornerRadius="1"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource OsmiumDividerBrush}" />

                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border x:Name="StepBadge2"
                                            Width="22"
                                            Height="22"
                                            CornerRadius="11"
                                            Background="{ThemeResource OsmiumSubtlePillBrush}">
                                        <Grid>
                                            <TextBlock x:Name="StepNum2"
                                                       Text="2"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <FontIcon x:Name="StepCheck2"
                                                      FontFamily="{StaticResource FluentIconsFont}"
                                                      Glyph="&#xE305;"
                                                      FontSize="11"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                      Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="StepLabel2"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Border x:Name="StepConnector2"
                                        Width="28"
                                        Height="2"
                                        CornerRadius="1"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource OsmiumDividerBrush}"
                                        Visibility="Collapsed" />


                                <StackPanel x:Name="StepNode3"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <Border x:Name="StepBadge3"
                                            Width="22"
                                            Height="22"
                                            CornerRadius="11"
                                            Background="{ThemeResource OsmiumSubtlePillBrush}">
                                        <Grid>
                                            <TextBlock x:Name="StepNum3"
                                                       Text="3"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <FontIcon x:Name="StepCheck3"
                                                      FontFamily="{StaticResource FluentIconsFont}"
                                                      Glyph="&#xE305;"
                                                      FontSize="11"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                      Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="StepLabel3"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="StepProgressText"
                                       Grid.Column="1"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>


                    <Border Style="{StaticResource OsmiumGroupedCardContainerStyle}">
                        <StackPanel>
                            <Grid x:Name="WizardSlideHost" SizeChanged="SlideHost_SizeChanged">

                                <StackPanel x:Name="StepPanelIdentity" Visibility="Collapsed">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="StepIdentityTransform" />
                                    </StackPanel.RenderTransform>

                                    <controls:SettingsRowCard x:Name="RowAuthEmail" IsGrouped="True" Glyph="&#xF506;">
                                        <TextBox x:Name="AuthEmailBox"
                                                 Width="260"
                                                 CornerRadius="6"
                                                 InputScope="EmailSmtpAddress"
                                                 TextChanged="AuthEmailBox_TextChanged"
                                                 KeyDown="AuthInput_KeyDown" />
                                    </controls:SettingsRowCard>

                                    <Border x:Name="DividerAuthUsername"
                                            Style="{StaticResource OsmiumHorizontalDividerStyle}"
                                            Visibility="Collapsed" />

                                    <controls:SettingsRowCard x:Name="RowAuthUsername" IsGrouped="True"
                                                              ShowIcon="False" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox x:Name="AuthUsernameBox"
                                                     Width="182"
                                                     MaxLength="32"
                                                     CornerRadius="6"
                                                     KeyDown="AuthInput_KeyDown" />
                                            <Button x:Name="BtnRandomAuthUsername"
                                                    CornerRadius="6"
                                                    Click="BtnRandomAuthUsername_Click" />
                                        </StackPanel>
                                    </controls:SettingsRowCard>
                                </StackPanel>


                                <StackPanel x:Name="StepPanelOtp" Visibility="Collapsed">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="StepOtpTransform" />
                                    </StackPanel.RenderTransform>

                                    <controls:SettingsRowCard x:Name="RowOtpEmailSummary" IsGrouped="True"
                                                              Glyph="&#xF506;">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock x:Name="OtpEmailSummaryText"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       IsTextSelectionEnabled="True" />
                                            <Button x:Name="BtnSendAuthOtp"
                                                    MinWidth="96"
                                                    CornerRadius="6"
                                                    Click="BtnSendAuthOtp_Click" />
                                        </StackPanel>
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowAuthOtp" IsGrouped="True" ShowIcon="False">
                                        <TextBox x:Name="AuthOtpBox"
                                                 Width="260"
                                                 MaxLength="12"
                                                 CornerRadius="6"
                                                 KeyDown="AuthInput_KeyDown" />
                                    </controls:SettingsRowCard>
                                </StackPanel>


                                <StackPanel x:Name="StepPanelPassword" Visibility="Collapsed">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="StepPasswordTransform" />
                                    </StackPanel.RenderTransform>

                                    <controls:SettingsRowCard x:Name="RowPwdEmailSummary" IsGrouped="True"
                                                              Glyph="&#xEAC8;">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock x:Name="PwdEmailSummaryText"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       IsTextSelectionEnabled="True" />
                                            <Button x:Name="BtnChangeWizardEmail"
                                                    CornerRadius="6"
                                                    Click="BtnChangeWizardEmail_Click" />
                                        </StackPanel>
                                    </controls:SettingsRowCard>

                                    <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                    <controls:SettingsRowCard x:Name="RowAuthPassword" IsGrouped="True"
                                                              ShowIcon="False">
                                        <controls:TogglePasswordBox x:Name="AuthPasswordBox"
                                                                    Width="260"
                                                                    CornerRadius="6"
                                                                    KeyDown="AuthInput_KeyDown" />
                                    </controls:SettingsRowCard>

                                    <Border x:Name="DividerAuthConfirmPwd"
                                            Style="{StaticResource OsmiumHorizontalDividerStyle}"
                                            Visibility="Collapsed" />

                                    <controls:SettingsRowCard x:Name="RowAuthConfirmPassword" IsGrouped="True"
                                                              ShowIcon="False" Visibility="Collapsed">
                                        <controls:TogglePasswordBox x:Name="AuthConfirmPasswordBox"
                                                                    Width="260"
                                                                    CornerRadius="6"
                                                                    KeyDown="AuthInput_KeyDown" />
                                    </controls:SettingsRowCard>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="WizardFooterDivider"
                                    Style="{StaticResource OsmiumHorizontalDividerStyle}" />


                            <Grid x:Name="WizardFooterGrid" Padding="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnWizardBack"
                                        Grid.Column="0"
                                        CornerRadius="6"
                                        Click="BtnWizardBack_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource FluentIconsFont}"
                                                  Glyph="&#xF2A9;"
                                                  FontSize="11"
                                                  VerticalAlignment="Center" />
                                        <TextBlock x:Name="BtnWizardBackText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <ProgressRing x:Name="WizardBusyRing"
                                                  Width="18"
                                                  Height="18"
                                                  IsActive="False"
                                                  Visibility="Collapsed" />
                                    <Button x:Name="BtnHaveOtpSkip"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Height="30"
                                            Padding="10,4"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            CornerRadius="6"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed"
                                            Click="BtnHaveOtpSkip_Click" />
                                    <Button x:Name="BtnWizardPrimary"
                                            Style="{StaticResource AccentButtonStyle}"
                                            MinWidth="128"
                                            CornerRadius="6"
                                            Click="BtnWizardPrimary_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock x:Name="BtnWizardPrimaryText" VerticalAlignment="Center" />
                                            <FontIcon x:Name="BtnWizardPrimaryIcon"
                                                      FontFamily="{StaticResource FluentIconsFont}"
                                                      Glyph="&#xF2AF;"
                                                      FontSize="11"
                                                      VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="QrLoginFlowPanel"
                            Spacing="10"
                            Visibility="Collapsed"
                            VerticalAlignment="Top">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="QrLoginFlowTransform" />
                    </StackPanel.RenderTransform>

                    <Border Style="{StaticResource OsmiumGroupedCardContainerStyle}">
                        <StackPanel>
                            <StackPanel Padding="24,28,24,22" Spacing="16" HorizontalAlignment="Center">
                                <Border Width="228"
                                        Height="228"
                                        CornerRadius="12"
                                        Background="White"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource OsmiumDividerBrush}"
                                        HorizontalAlignment="Center">
                                    <Grid>
                                        <Image x:Name="QrCodeImage"
                                               Width="208"
                                               Height="208"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />

                                        <ProgressRing x:Name="QrLoadingRing"
                                                      Width="34"
                                                      Height="34"
                                                      IsActive="False"
                                                      Visibility="Collapsed"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />

                                        <Border x:Name="QrOverlayBorder"
                                                Background="#EEFFFFFF"
                                                CornerRadius="11"
                                                Visibility="Collapsed">
                                            <StackPanel VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Spacing="10"
                                                        Padding="16">
                                                <Grid x:Name="QrScannedAvatarHost"
                                                      Width="48"
                                                      Height="48"
                                                      HorizontalAlignment="Center"
                                                      Visibility="Collapsed">
                                                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <FontIcon x:Name="QrOverlayIcon"
                                                              FontFamily="{StaticResource FluentIconsFont}"
                                                              Glyph="&#xE305;"
                                                              FontSize="20"
                                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    <Ellipse x:Name="QrScannedAvatarEllipse"
                                                             Width="48"
                                                             Height="48"
                                                             Visibility="Collapsed">
                                                        <Ellipse.Fill>
                                                            <ImageBrush x:Name="QrScannedAvatarBrush" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <TextBlock x:Name="QrScannedUserText"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FF1A1A1A"
                                                           HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="188"
                                                           Visibility="Collapsed" />
                                                <TextBlock x:Name="QrOverlayStatusText"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="#FF333333"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="188" />
                                                <Button x:Name="BtnQrOverlayRefresh"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        CornerRadius="6"
                                                        HorizontalAlignment="Center"
                                                        Visibility="Collapsed"
                                                        Click="BtnQrRefresh_Click" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="QrStatusText"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="QrCountdownText"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>

                            <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                            <Grid Padding="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnQrBack"
                                        Grid.Column="0"
                                        CornerRadius="6"
                                        Click="BtnQrBack_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource FluentIconsFont}"
                                                  Glyph="&#xF2A9;"
                                                  FontSize="11"
                                                  VerticalAlignment="Center" />
                                        <TextBlock x:Name="BtnQrBackText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnQrRefresh"
                                        Grid.Column="2"
                                        CornerRadius="6"
                                        Click="BtnQrRefresh_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>


        <Grid x:Name="LoggedInRootGrid" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <NavigationView
                x:Name="AccountNavView"
                Grid.Row="0"
                Margin="-12,0,0,10"
                AlwaysShowHeader="False"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                PaneDisplayMode="Top"
                SelectionChanged="AccountNavView_SelectionChanged">
                <NavigationView.Resources>
                    <x:Double x:Key="NavigationViewTopPaneHeight">42</x:Double>
                    <x:Double x:Key="TopNavigationViewPaneCustomContentMinWidth">0</x:Double>
                    <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
                    <Thickness x:Key="TopNavigationViewContentGridBorderThickness">0</Thickness>
                    <Thickness x:Key="TopNavigationViewContentMargin">0</Thickness>
                    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TopNavigationViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TopNavigationViewItemBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="TopNavigationViewItemBackgroundSelected" Color="Transparent" />
                    <SolidColorBrush x:Key="TopNavigationViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TopNavigationViewItemBackgroundSelectedPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="Transparent" />
                    <Style TargetType="NavigationViewItem">
                        <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </NavigationView.Resources>
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="NavTabProfile" Tag="Profile" IsSelected="True" />
                    <NavigationViewItem x:Name="NavTabDevices" Tag="Devices" />
                    <NavigationViewItem x:Name="NavTabHistory" Tag="History" />
                </NavigationView.MenuItems>
            </NavigationView>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,12">
                <Grid x:Name="TabSlideHost" SizeChanged="SlideHost_SizeChanged">

                    <StackPanel x:Name="PanelProfile" Spacing="8">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PanelProfileTransform" />
                        </StackPanel.RenderTransform>
                        <Border Style="{StaticResource OsmiumGroupedCardContainerStyle}">
                            <StackPanel>
                                <controls:SettingsRowCard x:Name="RowProfileAvatar" IsGrouped="True" Glyph="&#xEAC8;">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border Width="38"
                                                Height="38"
                                                CornerRadius="19"
                                                Background="{ThemeResource OsmiumSubtlePillBrush}"
                                                BorderBrush="{ThemeResource OsmiumCardBorderBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <FontIcon x:Name="AvatarFallbackIcon"
                                                          FontFamily="{StaticResource FluentIconsFont}"
                                                          Glyph="&#xEAC8;"
                                                          FontSize="18"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                <Ellipse x:Name="AvatarEllipse" Width="36" Height="36" Opacity="0"
                                                         Visibility="Collapsed">
                                                    <Ellipse.Fill>
                                                        <ImageBrush x:Name="AvatarImageBrush" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                        </Border>
                                        <Button x:Name="BtnChangeAvatar" CornerRadius="6" Click="BtnChangeAvatar_Click" />
                                    </StackPanel>
                                </controls:SettingsRowCard>

                                <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                <controls:SettingsRowCard x:Name="RowProfileUsername" IsGrouped="True" ShowIcon="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox x:Name="ProfileUsernameBox" Width="170" MaxLength="32"
                                                 CornerRadius="6" />
                                        <Button x:Name="BtnRandomProfileUsername" CornerRadius="6"
                                                Click="BtnRandomProfileUsername_Click" />
                                        <Button x:Name="BtnSaveUsername"
                                                Style="{StaticResource AccentButtonStyle}"
                                                CornerRadius="6"
                                                Click="BtnSaveUsername_Click" />
                                    </StackPanel>
                                </controls:SettingsRowCard>

                                <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                <controls:SettingsRowCard x:Name="RowProfileEmail" IsGrouped="True" ShowIcon="False">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock x:Name="ProfileEmailText"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   IsTextSelectionEnabled="True" />
                                        <Button x:Name="BtnChangeEmail" CornerRadius="6" Click="BtnChangeEmail_Click" />
                                    </StackPanel>
                                </controls:SettingsRowCard>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource OsmiumGroupedCardContainerStyle}">
                            <StackPanel>
                                <controls:SettingsRowCard x:Name="RowAccountLock" IsGrouped="True" Glyph="&#xF6C5;">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock x:Name="AccountLockStatusText"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="BtnRefreshStatus" CornerRadius="6"
                                                Click="BtnRefreshStatus_Click" />
                                        <Button x:Name="BtnToggleLock" CornerRadius="6" Click="BtnToggleLock_Click" />
                                    </StackPanel>
                                </controls:SettingsRowCard>

                                <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                <controls:SettingsRowCard x:Name="RowAccountBlacklist" IsGrouped="True"
                                                          ShowIcon="False">
                                    <Button x:Name="BtnManageBlacklist" CornerRadius="6"
                                            Click="BtnManageBlacklist_Click" />
                                </controls:SettingsRowCard>

                                <Border Style="{StaticResource OsmiumHorizontalDividerStyle}" />

                                <controls:SettingsRowCard x:Name="RowAccountSession" IsGrouped="True" ShowIcon="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="BtnLogout" CornerRadius="6" Click="BtnLogout_Click" />
                                        <Button x:Name="BtnDeleteAccount"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                CornerRadius="6"
                                                Click="BtnDeleteAccount_Click" />
                                    </StackPanel>
                                </controls:SettingsRowCard>
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <StackPanel x:Name="PanelDevices" Spacing="8" Visibility="Collapsed">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PanelDevicesTransform" />
                        </StackPanel.RenderTransform>
                        <controls:SettingsRowCard x:Name="RowDevicesHeader" Glyph="&#xF35A;">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock x:Name="DevicesCountText"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button x:Name="BtnRefreshDevices" CornerRadius="6" Click="BtnRefreshDevices_Click" />
                            </StackPanel>
                        </controls:SettingsRowCard>

                        <StackPanel x:Name="DevicesListPanel" Spacing="8" />
                    </StackPanel>


                    <StackPanel x:Name="PanelHistory" Spacing="8" Visibility="Collapsed">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PanelHistoryTransform" />
                        </StackPanel.RenderTransform>
                        <controls:SettingsRowCard x:Name="RowHistoryHeader" Glyph="&#xF2DD;">
                            <Button x:Name="BtnRefreshHistory" CornerRadius="6" Click="BtnRefreshHistory_Click" />
                        </controls:SettingsRowCard>

                        <StackPanel x:Name="HistoryListPanel" Spacing="8" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>


        <InfoBar x:Name="StatusInfoBar"
                 Grid.Row="2"
                 IsOpen="False"
                 IsClosable="True"
                 Margin="0,10,0,0" />
    </Grid>
</Page>