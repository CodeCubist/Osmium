<Window
    x:Class="Osmium.App.Views.RemoteSessionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Osmium.App.Controls"
    Title="Osmium">

    <controls:CursorLockGrid x:Name="RootSessionGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopBarRow" Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="VideoStageGrid"
              Grid.Row="1"
              Background="#0B0D12">

            <SwapChainPanel x:Name="VideoSwapChainPanel"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsHitTestVisible="False" />

            <controls:CursorLockGrid x:Name="VideoInputSurface"
                                     Background="#01000000"
                                     ManipulationMode="None"
                                     IsTabStop="True"
                                     UseSystemFocusVisuals="False"
                                     PointerEntered="VideoInputSurface_PointerEntered"
                                     PointerPressed="VideoInputSurface_PointerPressed"
                                     PointerReleased="VideoInputSurface_PointerReleased"
                                     PointerMoved="VideoInputSurface_PointerMoved"
                                     PointerWheelChanged="VideoInputSurface_PointerWheelChanged"
                                     PointerExited="VideoInputSurface_PointerExited" />

            <Border x:Name="WaitingVideoOverlay"
                    Background="#CC0B0D12"
                    IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="14">
                    <ProgressRing x:Name="WaitingProgressRing" IsActive="True" Width="34" Height="34"
                                  HorizontalAlignment="Center" />
                    <TextBlock x:Name="WaitingVideoText"
                               Foreground="#E6EDF7"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>


            <Border x:Name="TopToastBanner"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,14,0,0"
                    Padding="14,7"
                    CornerRadius="18"
                    Background="#E0141821"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Opacity="0"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TopToastTranslate" Y="-72" />
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="{StaticResource FluentIconsFont}"
                              Glyph="&#xE48D;"
                              FontSize="15"
                              Foreground="#60CDFF" />
                    <TextBlock x:Name="TopToastText"
                               Foreground="#F3F7FC"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>


            <Border x:Name="OsdOverlayBorder"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,14,12"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Grid IsHitTestVisible="False">
                    <StackPanel x:Name="OsdShadowPanel"
                                Spacing="2"
                                Margin="1,1,0,0"
                                IsHitTestVisible="False" />
                    <StackPanel x:Name="OsdTextPanel"
                                Spacing="2"
                                IsHitTestVisible="False">
                        <TextBlock x:Name="OsdConnTypeText"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF8FAFC"
                                   IsHitTestVisible="False" />
                        <TextBlock x:Name="OsdLatencyText"
                                   FontSize="11"
                                   Foreground="#FFF1F5F9"
                                   IsHitTestVisible="False" />
                        <TextBlock x:Name="OsdNativeResText"
                                   FontSize="11"
                                   Foreground="#FFF1F5F9"
                                   IsHitTestVisible="False" />
                        <TextBlock x:Name="OsdStreamResText"
                                   FontSize="11"
                                   Foreground="#FFF1F5F9"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />
                        <TextBlock x:Name="OsdFpsText"
                                   FontSize="11"
                                   Foreground="#FFF1F5F9"
                                   IsHitTestVisible="False" />
                        <TextBlock x:Name="OsdBitrateText"
                                   FontSize="11"
                                   Foreground="#FFF1F5F9"
                                   IsHitTestVisible="False" />
                        <TextBlock x:Name="OsdDurationText"
                                   FontSize="11"
                                   Foreground="#FFF1F5F9"
                                   IsHitTestVisible="False" />
                        <TextBlock x:Name="OsdPacketLossText"
                                   FontSize="11"
                                   Foreground="#FFE2E8F0"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />
                        <TextBlock x:Name="OsdDecodeText"
                                   FontSize="11"
                                   Foreground="#FFE2E8F0"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />
                        <TextBlock x:Name="OsdCodecText"
                                   FontSize="11"
                                   Foreground="#FFE2E8F0"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />
                        <TextBlock x:Name="OsdMouseText"
                                   FontSize="11"
                                   Foreground="#FFE2E8F0"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />
                        <TextBlock x:Name="OsdPeerText"
                                   FontSize="11"
                                   Foreground="#FFE2E8F0"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />
                    </StackPanel>
                </Grid>
            </Border>


            <Border x:Name="FullscreenTopHoverTrigger"
                    Height="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    Visibility="Collapsed"
                    PointerEntered="FullscreenTopHoverTrigger_PointerEntered" />
        </Grid>


        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="46"
              Padding="12,0,138,0"
              Background="#01000000"
              PointerEntered="AppTitleBar_PointerEntered"
              PointerExited="AppTitleBar_PointerExited">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>


            <Border x:Name="TitleBarBottomDivider"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Height="1"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Margin="-12,0,-160,0"
                    Background="{ThemeResource OsmiumDividerBrush}"
                    IsHitTestVisible="False" />


            <StackPanel x:Name="BrandChipHost"
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Margin="4,0,14,0"
                        IsHitTestVisible="False">
                <controls:OsmiumLogoControl Width="17" Height="17" />
                <TextBlock x:Name="RemoteHostTitleText"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           MaxWidth="220"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center" />
            </StackPanel>


            <Grid x:Name="BrowserTabsArea"
                  Grid.Column="1"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="0,0,10,0">
                <ScrollViewer x:Name="DisplayTabsScrollViewer"
                              HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DisplayTabsPanel"
                                Orientation="Horizontal"
                                Spacing="0"
                                VerticalAlignment="Top" />
                </ScrollViewer>
            </Grid>


            <StackPanel x:Name="RightMenuToolbar"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        Height="32"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Margin="0,0,6,0">

                <Border x:Name="HostLockedPillBorder"
                        Visibility="Collapsed"
                        CornerRadius="6"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Background="{ThemeResource OsmiumBadgeDangerBg}">
                    <TextBlock x:Name="HostLockedPill"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource OsmiumBadgeDangerFg}"
                               VerticalAlignment="Center" />
                </Border>

                <Button x:Name="SessionMenuButton"
                        Height="28"
                        Padding="10,0"
                        CornerRadius="6"
                        VerticalAlignment="Center"
                        Background="{ThemeResource OsmiumSubtlePillBrush}"
                        BorderThickness="0"
                        IsTabStop="False"
                        UseSystemFocusVisuals="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource FluentIconsFont}"
                                  Glyph="&#xEABB;"
                                  FontSize="14"
                                  VerticalAlignment="Center" />
                        <TextBlock x:Name="SessionMenuBtnText"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="SessionMenuFlyout"
                                    Placement="BottomEdgeAlignedRight"
                                    Opened="SessionMenuFlyout_Opened"
                                    Closed="SettingsFlyout_Closed">
                            <MenuFlyout.MenuFlyoutPresenterStyle>
                                <Style TargetType="MenuFlyoutPresenter">
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="MinWidth" Value="228" />
                                    <Setter Property="Padding" Value="0,4" />
                                </Style>
                            </MenuFlyout.MenuFlyoutPresenterStyle>

                            <MenuFlyoutSubItem x:Name="MenuSubDisplay">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon FontFamily="{StaticResource FluentIconsFont}" Glyph="&#xF35A;" />
                                </MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>

                            <MenuFlyoutSeparator />

                            <MenuFlyoutSubItem x:Name="MenuSubQuality">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon FontFamily="{StaticResource FluentIconsFont}" Glyph="&#xF84D;" />
                                </MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem x:Name="HostNativeResMenuItem" IsEnabled="False" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem x:Name="MenuSubResolution" />
                                <MenuFlyoutSubItem x:Name="MenuSubFps" />
                                <MenuFlyoutItem x:Name="SessionBitrateMenuItem" Click="SessionBitrateMenuItem_Click" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem x:Name="HdrMenuItem" Click="HdrMenuItem_Click" />
                                <ToggleMenuFlyoutItem x:Name="Yuv444MenuItem" Click="Yuv444MenuItem_Click" />
                                <ToggleMenuFlyoutItem x:Name="VsyncMenuItem" Click="VsyncMenuItem_Click" />
                            </MenuFlyoutSubItem>

                            <MenuFlyoutSubItem x:Name="MenuSubMouse">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon FontFamily="{StaticResource FluentIconsFont}" Glyph="&#xE48D;" />
                                </MenuFlyoutSubItem.Icon>
                                <RadioMenuFlyoutItem x:Name="MouseModeControllerMenuItem"
                                                     GroupName="MouseModeGroup"
                                                     Tag="0"
                                                     Click="MouseModeMenuItem_Click" />
                                <RadioMenuFlyoutItem x:Name="MouseModeVirtualMenuItem"
                                                     GroupName="MouseModeGroup"
                                                     Tag="1"
                                                     Click="MouseModeMenuItem_Click" />
                                <RadioMenuFlyoutItem x:Name="MouseModeSmartMenuItem"
                                                     GroupName="MouseModeGroup"
                                                     Tag="2"
                                                     Click="MouseModeMenuItem_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="ReleaseCursorLockMenuItem"
                                                KeyboardAcceleratorTextOverride="Ctrl+Alt+Shift+M"
                                                Click="ReleaseCursorLockItem_Click" />
                            </MenuFlyoutSubItem>

                            <MenuFlyoutSubItem x:Name="MenuSubAudio">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon FontFamily="{StaticResource FluentIconsFont}" Glyph="&#xEB43;" />
                                </MenuFlyoutSubItem.Icon>
                                <ToggleMenuFlyoutItem x:Name="VirtualSpeakerMenuItem"
                                                      Click="VirtualAudioMenuItem_Click" />
                                <ToggleMenuFlyoutItem x:Name="VirtualMicMenuItem" Click="VirtualAudioMenuItem_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem x:Name="MenuSubLocalMic" />
                            </MenuFlyoutSubItem>

                            <MenuFlyoutSubItem x:Name="MenuSubClipboardTransfer">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon FontFamily="{StaticResource FluentIconsFont}" Glyph="&#xF4C8;" />
                                </MenuFlyoutSubItem.Icon>
                                <ToggleMenuFlyoutItem x:Name="SharedClipboardMenuItem"
                                                      Click="SharedClipboardMenuItem_Click" />
                                <ToggleMenuFlyoutItem x:Name="FileTransferMenuItem" Click="FileTransferMenuItem_Click" />
                                <MenuFlyoutItem x:Name="TransferStatusMenuItem"
                                                IsEnabled="False"
                                                Visibility="Collapsed" />
                            </MenuFlyoutSubItem>

                            <MenuFlyoutSubItem x:Name="MenuSubTools">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon FontFamily="{StaticResource FluentIconsFont}" Glyph="&#xF588;" />
                                </MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem x:Name="CtrlAltDelMenuItem"
                                                Text="Ctrl+Alt+Del"
                                                Click="SendCtrlAltDel_Click" />
                                <MenuFlyoutItem x:Name="TaskManagerMenuItem"
                                                Click="OpenTaskManager_Click" />
                                <MenuFlyoutItem x:Name="PrivacyScreenMenuItem"
                                                Visibility="Collapsed"
                                                Click="PrivacyScreenMenuItem_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem x:Name="MenuSubDrivers">
                                    <MenuFlyoutItem x:Name="HostDriverStatusMenuItem" IsEnabled="False" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="RemoteInstallDriversMenuItem"
                                                    Click="RemoteInstallDrivers_Click" />
                                    <MenuFlyoutItem x:Name="RemoteUninstallDriversMenuItem"
                                                    Click="RemoteUninstallDrivers_Click" />
                                </MenuFlyoutSubItem>
                            </MenuFlyoutSubItem>

                            <MenuFlyoutSubItem x:Name="MenuSubMore">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon FontFamily="{StaticResource FluentIconsFont}" Glyph="&#xEE5E;" />
                                </MenuFlyoutSubItem.Icon>
                                <ToggleMenuFlyoutItem x:Name="OsdToggleMenuItem"
                                                      KeyboardAcceleratorTextOverride="Ctrl+Alt+Shift+O"
                                                      Click="OsdToggleMenuItem_Click" />
                                <MenuFlyoutSubItem x:Name="MenuSubOsdDetail">
                                    <RadioMenuFlyoutItem x:Name="OsdDetailCompactMenuItem"
                                                         GroupName="OsdDetailGroup"
                                                         Tag="0"
                                                         Click="OsdDetailMenuItem_Click" />
                                    <RadioMenuFlyoutItem x:Name="OsdDetailStandardMenuItem"
                                                         GroupName="OsdDetailGroup"
                                                         Tag="1"
                                                         Click="OsdDetailMenuItem_Click" />
                                    <RadioMenuFlyoutItem x:Name="OsdDetailDetailedMenuItem"
                                                         GroupName="OsdDetailGroup"
                                                         Tag="2"
                                                         Click="OsdDetailMenuItem_Click" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="ViewDebugInfoMenuItem" Click="ViewDebugInfo_Click" />
                                <MenuFlyoutItem x:Name="CopyDebugInfoMenuItem" Click="CopyDebugInfo_Click" />
                            </MenuFlyoutSubItem>

                            <MenuFlyoutSeparator />

                            <MenuFlyoutItem x:Name="FullscreenMenuItem"
                                            KeyboardAcceleratorTextOverride="F11"
                                            Click="FullscreenBtn_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource FluentIconsFont}" Glyph="&#xF66F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutSeparator />

                            <MenuFlyoutItem x:Name="DisconnectMenuItem"
                                            Foreground="{ThemeResource OsmiumBadgeDangerFg}"
                                            KeyboardAcceleratorTextOverride="Ctrl+Alt+Shift+Q"
                                            Click="DisconnectBtn_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7E8;" Foreground="{ThemeResource OsmiumBadgeDangerFg}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </controls:CursorLockGrid>
</Window>