<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
        <RootNamespace>Osmium.App</RootNamespace>
        <AssemblyName>Osmium</AssemblyName>
        <Version>1.1.0</Version>
        <AssemblyVersion>1.1.0</AssemblyVersion>
        <FileVersion>1.1.0</FileVersion>
        <Copyright>Copyright © Osmium Development Team</Copyright>
        <DefaultLanguage>zh-CN</DefaultLanguage>
        <SatelliteResourceLanguages>zh-CN;zh-Hans;en-US</SatelliteResourceLanguages>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>..\..\assets\osmium.ico</ApplicationIcon>
        <Platforms>x64</Platforms>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <UseWinUI>true</UseWinUI>
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <EnableMsixTooling>true</EnableMsixTooling>
        <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
        <StartupObject>Osmium.App.Program</StartupObject>
        <PublishTrimmed>false</PublishTrimmed>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <PublishProfile>Properties\PublishProfiles\win-x64.pubxml</PublishProfile>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0"/>
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.29648.1000-preview"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Osmium.Core\Osmium.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\assets\osmium.ico">
            <Link>Assets\osmium.ico</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="..\..\assets\osmium_logo.svg">
            <Link>Assets\osmium_logo.svg</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="..\..\assets\osmium_logo.png">
            <Link>Assets\osmium_logo.png</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="..\..\assets\icons\google.svg">
            <Link>Assets\icons\google.svg</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="..\..\assets\icons\qq.svg">
            <Link>Assets\icons\qq.svg</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="..\..\assets\icons\wechat.svg">
            <Link>Assets\icons\wechat.svg</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\Fonts\FluentSystemIcons-Regular.ttf">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Assets\zh-cn-l.ttf">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <Target Name="GenerateGitBuildInfo" BeforeTargets="BeforeCompile;CoreCompile">
        <Exec Command="git -C &quot;$(MSBuildProjectDirectory)\..\..&quot; rev-parse --abbrev-ref HEAD"
              ConsoleToMSBuild="true"
              IgnoreExitCode="true"
              StandardOutputImportance="Low"
              StandardErrorImportance="Low">
            <Output TaskParameter="ConsoleOutput" PropertyName="_OsmiumGitBranchRaw"/>
            <Output TaskParameter="ExitCode" PropertyName="_OsmiumGitBranchExit"/>
        </Exec>
        <Exec Command="git -C &quot;$(MSBuildProjectDirectory)\..\..&quot; rev-parse HEAD"
              ConsoleToMSBuild="true"
              IgnoreExitCode="true"
              StandardOutputImportance="Low"
              StandardErrorImportance="Low">
            <Output TaskParameter="ConsoleOutput" PropertyName="_OsmiumGitHashRaw"/>
            <Output TaskParameter="ExitCode" PropertyName="_OsmiumGitHashExit"/>
        </Exec>
        <PropertyGroup>
            <_OsmiumGitBranch Condition="'$(_OsmiumGitBranchExit)' == '0' and '$(_OsmiumGitBranchRaw)' != ''">$(_OsmiumGitBranchRaw.Trim())</_OsmiumGitBranch>
            <_OsmiumGitBranch Condition="('$(_OsmiumGitBranch)' == '' or '$(_OsmiumGitBranch)' == 'HEAD') and '$(GITHUB_HEAD_REF)' != ''">$(GITHUB_HEAD_REF.Trim())</_OsmiumGitBranch>
            <_OsmiumGitBranch Condition="('$(_OsmiumGitBranch)' == '' or '$(_OsmiumGitBranch)' == 'HEAD') and '$(GITHUB_REF_NAME)' != ''">$(GITHUB_REF_NAME.Trim())</_OsmiumGitBranch>
            <_OsmiumGitBranch Condition="'$(_OsmiumGitBranch)' == '' or '$(_OsmiumGitBranch)' == 'HEAD'">unknown</_OsmiumGitBranch>

            <_OsmiumGitHash Condition="'$(_OsmiumGitHashExit)' == '0' and '$(_OsmiumGitHashRaw)' != ''">$(_OsmiumGitHashRaw.Trim())</_OsmiumGitHash>
            <_OsmiumGitHash Condition="'$(_OsmiumGitHash)' == '' and '$(GITHUB_SHA)' != ''">$(GITHUB_SHA.Trim())</_OsmiumGitHash>
            <_OsmiumGitHash Condition="'$(_OsmiumGitHash)' == ''">unknown</_OsmiumGitHash>

            <_OsmiumGitBranchEsc>$(_OsmiumGitBranch.Replace('\', '\\').Replace('&quot;', '\&quot;'))</_OsmiumGitBranchEsc>
            <_OsmiumGitHashEsc>$(_OsmiumGitHash.Replace('\', '\\').Replace('&quot;', '\&quot;'))</_OsmiumGitHashEsc>
            <_OsmiumGitInfoFile>$(IntermediateOutputPath)OsmiumGitInfo.g.cs</_OsmiumGitInfoFile>
        </PropertyGroup>
        <ItemGroup>
            <_OsmiumGitInfoLine Include="// Auto-generated at build time"/>
            <_OsmiumGitInfoLine Include="[assembly: global::System.Reflection.AssemblyMetadataAttribute(&quot;GitBranch&quot;, &quot;$(_OsmiumGitBranchEsc)&quot;)]"/>
            <_OsmiumGitInfoLine Include="[assembly: global::System.Reflection.AssemblyMetadataAttribute(&quot;GitCommitHash&quot;, &quot;$(_OsmiumGitHashEsc)&quot;)]"/>
        </ItemGroup>
        <WriteLinesToFile File="$(_OsmiumGitInfoFile)"
                          Lines="@(_OsmiumGitInfoLine)"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true"
                          Encoding="UTF-8"/>
        <ItemGroup>
            <Compile Remove="$(_OsmiumGitInfoFile)"/>
            <Compile Include="$(_OsmiumGitInfoFile)"/>
            <FileWrites Include="$(_OsmiumGitInfoFile)"/>
        </ItemGroup>
    </Target>

    <Target Name="ResolveNativeRuntimeFiles" BeforeTargets="AssignTargetPaths">
        <PropertyGroup>
            <OsmiumNativeBinDir Condition="Exists('..\..\native\bin\x64\$(Configuration)\OsmiumEngine.dll')">..\..\native\bin\x64\$(Configuration)</OsmiumNativeBinDir>
            <OsmiumNativeBinDir Condition="'$(OsmiumNativeBinDir)' == '' and Exists('..\..\native\bin\x64\Release\OsmiumEngine.dll')">..\..\native\bin\x64\Release</OsmiumNativeBinDir>
            <OsmiumNativeBinDir Condition="'$(OsmiumNativeBinDir)' == ''">..\..\native\build\bin\Release</OsmiumNativeBinDir>
        </PropertyGroup>
        <ItemGroup Condition="Exists('$(OsmiumNativeBinDir)\OsmiumEngine.dll')">
            <None Include="$(OsmiumNativeBinDir)\OsmiumEngine.dll"
                  Link="OsmiumEngine.dll"
                  CopyToOutputDirectory="PreserveNewest"
                  CopyToPublishDirectory="PreserveNewest"/>
            <None Include="$(OsmiumNativeBinDir)\SDL3.dll"
                  Condition="Exists('$(OsmiumNativeBinDir)\SDL3.dll')"
                  Link="SDL3.dll"
                  CopyToOutputDirectory="PreserveNewest"
                  CopyToPublishDirectory="PreserveNewest"/>
            <None Include="$(OsmiumNativeBinDir)\avcodec-63.dll"
                  Condition="Exists('$(OsmiumNativeBinDir)\avcodec-63.dll')"
                  Link="avcodec-63.dll"
                  CopyToOutputDirectory="PreserveNewest"
                  CopyToPublishDirectory="PreserveNewest"/>
            <None Include="$(OsmiumNativeBinDir)\avutil-61.dll"
                  Condition="Exists('$(OsmiumNativeBinDir)\avutil-61.dll')"
                  Link="avutil-61.dll"
                  CopyToOutputDirectory="PreserveNewest"
                  CopyToPublishDirectory="PreserveNewest"/>
            <None Include="$(OsmiumNativeBinDir)\swscale-10.dll"
                  Condition="Exists('$(OsmiumNativeBinDir)\swscale-10.dll')"
                  Link="swscale-10.dll"
                  CopyToOutputDirectory="PreserveNewest"
                  CopyToPublishDirectory="PreserveNewest"/>
            <None Include="$(OsmiumNativeBinDir)\swresample-7.dll"
                  Condition="Exists('$(OsmiumNativeBinDir)\swresample-7.dll')"
                  Link="swresample-7.dll"
                  CopyToOutputDirectory="PreserveNewest"
                  CopyToPublishDirectory="PreserveNewest"/>
            <None Include="$(OsmiumNativeBinDir)\gamecontrollerdb.txt"
                  Condition="Exists('$(OsmiumNativeBinDir)\gamecontrollerdb.txt')"
                  Link="gamecontrollerdb.txt"
                  CopyToOutputDirectory="PreserveNewest"
                  CopyToPublishDirectory="PreserveNewest"/>
            <NativeDriverAsset Include="$(OsmiumNativeBinDir)\drivers\**\*.*"
                               Condition="Exists('$(OsmiumNativeBinDir)\drivers')"/>
            <None Include="@(NativeDriverAsset)"
                  Link="drivers\%(RecursiveDir)%(Filename)%(Extension)"
                  CopyToOutputDirectory="PreserveNewest"
                  CopyToPublishDirectory="PreserveNewest"/>
        </ItemGroup>
    </Target>

    <Target Name="RemoveUnwantedBuildArtifacts" AfterTargets="Build">
        <ItemGroup Condition="Exists('$(OutDir)runtimes')">
            <_BuildAllRuntimeDirs Include="$([System.IO.Directory]::GetDirectories('$(OutDir)runtimes'))"/>
            <_BuildWinRuntimeDirs Include="$([System.IO.Directory]::GetDirectories('$(OutDir)runtimes', 'win*'))"/>
            <_BuildRuntimeDirsToDelete Include="@(_BuildAllRuntimeDirs)" Exclude="@(_BuildWinRuntimeDirs)"/>
        </ItemGroup>
        <RemoveDir Directories="@(_BuildRuntimeDirsToDelete)" Condition="'@(_BuildRuntimeDirsToDelete)' != ''"/>

        <ItemGroup>
            <_BuildLangResourceFiles Include="$(OutDir)*\*.mui;$(OutDir)*\Microsoft.ui.xaml*.pri;$(OutDir)Microsoft.UI.Xaml\*\*.mui;$(OutDir)Microsoft.UI.Xaml\*\*.pri"
                                     Exclude="$(OutDir)zh-CN\*;$(OutDir)zh-Hans\*;$(OutDir)en-US\*;$(OutDir)Microsoft.UI.Xaml\zh-CN\*;$(OutDir)Microsoft.UI.Xaml\zh-Hans\*;$(OutDir)Microsoft.UI.Xaml\en-US\*"/>
            <_BuildLangDirsRaw Include="@(_BuildLangResourceFiles->'%(RootDir)%(Directory)')"/>
        </ItemGroup>
        <RemoveDuplicates Inputs="@(_BuildLangDirsRaw)">
            <Output TaskParameter="Filtered" ItemName="_BuildLangDirsToDelete"/>
        </RemoveDuplicates>
        <RemoveDir Directories="@(_BuildLangDirsToDelete)" Condition="'@(_BuildLangDirsToDelete)' != ''"/>

        <Message Text="build清理完成" Importance="high"/>
    </Target>

    <Target Name="RemoveUnwantedPublishArtifacts" AfterTargets="Publish" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')">
        <ItemGroup Condition="Exists('$(PublishDir)runtimes')">
            <_PublishAllRuntimeDirs Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)runtimes'))"/>
            <_PublishWinRuntimeDirs Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)runtimes', 'win*'))"/>
            <_PublishRuntimeDirsToDelete Include="@(_PublishAllRuntimeDirs)" Exclude="@(_PublishWinRuntimeDirs)"/>
        </ItemGroup>
        <RemoveDir Directories="@(_PublishRuntimeDirsToDelete)" Condition="'@(_PublishRuntimeDirsToDelete)' != ''"/>

        <ItemGroup>
            <_PublishLangResourceFiles Include="$(PublishDir)*\*.mui;$(PublishDir)*\Microsoft.ui.xaml*.pri;$(PublishDir)Microsoft.UI.Xaml\*\*.mui;$(PublishDir)Microsoft.UI.Xaml\*\*.pri"
                                       Exclude="$(PublishDir)zh-CN\*;$(PublishDir)zh-Hans\*;$(PublishDir)en-US\*;$(PublishDir)Microsoft.UI.Xaml\zh-CN\*;$(PublishDir)Microsoft.UI.Xaml\zh-Hans\*;$(PublishDir)Microsoft.UI.Xaml\en-US\*"/>
            <_PublishLangDirsRaw Include="@(_PublishLangResourceFiles->'%(RootDir)%(Directory)')"/>
        </ItemGroup>
        <RemoveDuplicates Inputs="@(_PublishLangDirsRaw)">
            <Output TaskParameter="Filtered" ItemName="_PublishLangDirsToDelete"/>
        </RemoveDuplicates>
        <RemoveDir Directories="@(_PublishLangDirsToDelete)" Condition="'@(_PublishLangDirsToDelete)' != ''"/>

        <Message Text="清理完成" Importance="high"/>
    </Target>
</Project>